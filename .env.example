# Copy to .env and fill in. A real environment variable always wins over .env.
# Local:     postgresql:///b4p_v2
# Supabase:  Project Settings -> Database -> Connection string -> "Session pooler" URI
DATABASE_URL=postgresql:///b4p_v2

# Read the sheet directly with a Google service account (read-only). Either:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}   (key contents; use this in GitHub secrets)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# INVENTORY_WORKSHEET_GID=1019735220          # 'Final Inventorying' tab
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<id>/export?format=csv&gid=<gid>

# Safety rails (set for ONE run when a big change is intentional)
# B4P_MAX_REMOVE_FRACTION=0.15   # max drop vs. the most active items in the last 24h
# B4P_MIN_KEY_OVERLAP=0.5        # min share of sheet rows that must be known items

# One-time import of old requests (OFF unless one of these is set; the database
# is the source of truth for requests)
# REQUESTS_URL=https://.../requests
# ORG_REQUESTS_WORKSHEET_TITLE=Requests       # tab in REQUESTS_SHEET_ID (default = inventory sheet)
# REQUESTS_SHEET_ID=
